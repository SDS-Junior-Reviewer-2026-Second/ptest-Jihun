+.guestbook-bubble[data-mine="true"] { align-self: flex-end; background: #302916; border-color: #57451e; border-radius: 14px 0 14px 14px; }
+.guestbook-bubble strong { color: var(--geum); font-size: 12px; font-weight: 500; }
+.guestbook-bubble p { white-space: pre-wrap; margin: 6px 0; font-size: 14px; }
+.guestbook-bubble time { display: block; font-size: 10px; color: var(--paper-2); text-align: right; }
+.guestbook-composer { display: grid; gap: 8px; border-top: 1px solid var(--line); padding-top: 18px; }
+.guestbook-name-row { display: flex; gap: 10px; align-items: center; font-size: 13px; }
