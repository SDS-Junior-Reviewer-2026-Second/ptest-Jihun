--- /dev/null
+++ b/assets/daily.css
@@ -0,0 +1,67 @@
+.daily-nav { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 36px; }
+.daily-nav a { border: 1px solid var(--line); padding: 9px 16px; text-decoration: none; color: var(--paper-2); font-size: 13px; }
+.daily-nav a:hover { border-color: var(--geum); color: var(--geum); }
+.daily-section { scroll-margin-top: 24px; }
+.daily-badge { display: inline-block; vertical-align: middle; font: 12px var(--body); color: var(--geum); border: 1px solid var(--geum); padding: 5px 9px; }
+.daily-grid { display: grid; grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr); gap: 28px; align-items: start; }
+.daily-card { min-width: 0; border: 1px solid var(--line); border-top: 2px solid var(--geum); padding: clamp(18px, 3vw, 30px); background: var(--ink-2); }
+.daily-kicker { font: 12px var(--mono); color: var(--geum); letter-spacing: .07em; }
+.daily-intro { font: clamp(21px, 3vw, 28px)/1.5 var(--display); margin: 18px 0 12px; }
+.daily-muted, .daily-side { color: var(--paper-2); font-size: 13px; }
+.daily-side { padding: 10px 0; }
+.daily-side h3 { font: 23px/1.45 var(--display); color: var(--paper); margin: 12px 0; }
+.daily-side-mark { font: 64px/1 var(--display); color: var(--geum); margin: 0; opacity: .7; }
+.daily-side details { margin-top: 22px; border-top: 1px solid var(--line); padding-top: 16px; }
+.daily-side summary { cursor: pointer; color: var(--paper); }
+.daily-form { display: grid; gap: 10px; margin-top: 24px; }
+.daily-form label, .daily-side label { font-size: 13px; color: var(--paper-2); }
+.daily-input-row { display: flex; gap: 8px; }
+.daily-section input, .daily-section textarea { display: block; width: 100%; min-width: 0; background: var(--ink); border: 1px solid var(--paper-3); border-radius: 2px; color: var(--paper); padding: 12px; font: 16px/1.5 var(--body); }
+.daily-section textarea { resize: vertical; }
+.daily-section :is(input, textarea, button, summary, a):focus-visible { outline: 2px solid var(--geum); outline-offset: 4px; }
+.daily-section input::placeholder, .daily-section textarea::placeholder { color: var(--paper-3); }
+.daily-button { flex-shrink: 0; min-height: 44px; background: var(--geum); border: 1px solid var(--geum); color: var(--ink); padding: 10px 16px; font: 500 14px/1.5 var(--body); cursor: pointer; border-radius: 2px; }
+.daily-button:hover { filter: brightness(1.12); }
+.daily-button.secondary { background: transparent; border-color: var(--paper-3); color: var(--paper-2); }
+.daily-button:disabled { opacity: .45; cursor: default; }
+.daily-status { min-height: 1.75em; color: var(--cheong); font-size: 13px; overflow-wrap: anywhere; }
+.daily-actions { display: flex; flex-wrap: wrap; gap: 8px; }
+.daily-table-wrap { max-height: 390px; overflow: auto; margin-top: 22px; }
+.daily-table { width: 100%; border-collapse: collapse; font-size: 13px; font-variant-numeric: tabular-nums; }
+.daily-table caption { text-align: left; color: var(--paper-2); padding-bottom: 10px; }
+.daily-table th { font-weight: 400; color: var(--paper-2); text-align: left; background: var(--ink-2); position: sticky; top: 0; }
+.daily-table :is(th, td) { padding: 10px 5px; border-bottom: 1px solid var(--line); }
+.daily-table td:nth-child(n+3), .daily-table th:nth-child(n+3) { text-align: right; }
+.daily-table tr[data-latest="true"] { background: rgba(201,162,39,.09); }
+.daily-table tr[data-solved="true"] { color: var(--geum); }
+.daily-empty { text-align: center; color: var(--paper-3); }
+.daily-dictionary { max-height: 180px; overflow-y: auto; overflow-wrap: anywhere; }
+.fortune-card { text-align: center; padding: 34px clamp(18px, 4vw, 48px); border: 1px solid var(--line); background: radial-gradient(ellipse at top, rgba(201,162,39,.09), transparent 70%), var(--ink-2); }
+.fortune-cookie { font-size: 76px; line-height: 1.4; transition: transform 400ms ease; }
+.fortune-cookie.is-open { transform: rotate(-15deg) scale(.85); }
+.fortune-teaser { font: 25px/1.5 var(--display); }
+.fortune-paper { max-width: 580px; margin: 24px auto; background: var(--paper); color: var(--ink); padding: 26px; border-left: 4px solid var(--geum); animation: fortune-unfold 400ms ease both; }
+.fortune-paper .daily-kicker { color: #70551c; }
+.fortune-paper blockquote { margin: 14px 0; font: clamp(22px, 3vw, 30px)/1.6 var(--display); }
+.fortune-paper .daily-button { color: var(--ink); border-color: #70551c; }
